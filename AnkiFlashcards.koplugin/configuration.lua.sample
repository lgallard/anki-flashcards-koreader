    provider          = "https://dashscope-intl.aliyuncs.com/compatible-mode/v1/chat/completions",
    model             = "qwen-plus",

    -- ── Image provider ────────────────────────────────────────────────────
    -- Which service to use for image generation.
    -- Options: "dashscope" (default, requires dashscope_api_key),
